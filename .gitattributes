# 统一换行符：仓库内一律 LF，检出也写 LF（覆盖本机 core.autocrlf=true）
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制，禁止换行符转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.svg     text eol=lf
*.woff    binary
*.woff2   binary
*.ttf     binary
*.mp3     binary
*.mp4     binary
*.bundle  binary

# /etc/blog/site.env —— deploy/install-stage2.sh 渲染 nginx 模板的参数源
# 首装时由安装脚本从本文件复制（并把 ECS_IP 填成 metadata 里的公网 IP），之后永不覆盖；真文件权限 root:root 0600
# 本示例不含任何凭据，可入库
SITE_DOMAIN=tuanzi-wow.cn
SITE_WWW=www.tuanzi-wow.cn
ECS_IP=REPLACE_ME
# 备案审核期（§0.2 K3）：域名 80 被云平台 403，只有 IP 直访能看到站点，所以这里指向公网 IP
# 备案通过后：把下面这行等号后面清空，重跑 install-stage2.sh，IP 直访就回到 default_server 的 404
IPSERVERNAME=$ECS_IP
# 站点根：deploy.sh 原子切换的软链，nginx 只认这一个入口
SITE_ROOT=/srv/blog/current
# 谁能访问 /_deploy（空格分隔的 IP 或 CIDR）。备案后接 GitHub Webhook 时，把 GitHub 钩子网段追加进来
DEPLOY_ALLOW='127.0.0.1 ::1'
# Let's Encrypt 注册邮箱；留空则安装脚本用 --register-unsafely-without-email（到期由阶段 4 告警兜底）
CERTBOT_EMAIL=
# /etc/blog/deploy.env —— scripts/deploy.sh 开头 source 的运行参数（首装从本文件复制，之后永不覆盖）
KEEP=5                        # 保留最近 5 版可回滚
MIN_HTML=30                   # 产物 html 文件数下限（实测 75 页）；低于即判构建异常，不切版
SITE_HOST=tuanzi-wow.cn       # 切软链后本机自检时发的 Host 头
BLOG_USER=blog                # git 与 hugo 一律降权到它
PULL_HOST=origin
PULL_REF=main
HUGO=hugo                     # /usr/local/bin/hugo -> /srv/blog/bin/hugo（0.165.0，与本机同版本）
REINDEX_URL=http://127.0.0.1:8000/api/reindex
REINDEX_TOKEN=                # 阶段 3 后端启用鉴权后填
GIT_HTTP_VERSION=HTTP/1.1   # 这台机走 GitHub 的 HTTP/2 会报 curl 16（HTTP2 framing）；置空即回到 git 默认
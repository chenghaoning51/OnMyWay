# /etc/blog/deploy.env —— scripts/deploy.sh 开头 source 的运行参数（首装从本文件复制，之后永不覆盖）
KEEP=5                        # 保留最近 5 版可回滚
MIN_HTML=30                   # 产物 html 文件数下限（实测 75 页）；低于即判构建异常，不切版
SITE_HOST=tuanzi-wow.cn       # 切软链后本机自检时发的 Host 头
BLOG_USER=blog                # git 与 hugo 一律降权到它
PULL_HOST=origin              # remote 名；remote origin 的 url 在 Gitee 切换后指向 gitee.com（境内稳定源，见 runbook §7）
PULL_REF=main
HUGO=hugo                     # /usr/local/bin/hugo -> /srv/blog/bin/hugo（0.165.0，与本机同版本）
REINDEX_URL=http://127.0.0.1:8000/api/reindex
REINDEX_TOKEN=                # 由 deploy/install-stage3.sh 自动生成并回填（同一值存 /etc/blog/api.env），勿手填
GIT_HTTP_VERSION=HTTP/1.1     # 置空即回到 git 默认；见下条症状说明
GIT_NET_TIMEOUT=40            # 单次网络 git 调用的硬超时（秒）。实测到 GitHub:443 间歇不可达：connect 130 s 超时、GnuTLS recv error(-110)、curl 16 HTTP2 framing 都出现过
